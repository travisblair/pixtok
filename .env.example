# Pixiv refresh token — permanent, use to get fresh access tokens hourly
# Get yours: python3 pixiv_auth.py login
PIXIV_REFRESH_TOKEN=your_refresh_token_here

# Web session cookie for the personalized web AJAX feed (Home tab).
# Copy PHPSESSID from Chrome DevTools after logging into pixiv.net.
PIXIV_PHPSESSID=your_phpsessid_here

# Session-bound CSRF token for street POSTs (scraped from the profile
# page's preloaded state with the same PHPSESSID). Optional — the
# backend scrapes it itself when empty.
PIXTOK_CSRF_TOKEN=your_csrf_token_here

# Shared secret between backend and the Vite dev proxy. The proxy injects
# it server-side as X-Api-Key; direct requests to the backend get 401.
# Generate: openssl rand -hex 16
PIXTOK_API_KEY=your_key_here

# App password gate (bcrypt hash) — the app's own lock on the public
# Funnel. Generate: htpasswd -bnBC 10 "" 'your-password' | tr -d ':\n'
PIXTOK_GATE_PASSWORD_HASH=your_bcrypt_hash_here

# Frontend (Vite) — hostnames allowed to reach the dev server.
# e.g. VITE_ALLOWED_HOSTS=.your-tailnet.ts.net
VITE_ALLOWED_HOSTS=
